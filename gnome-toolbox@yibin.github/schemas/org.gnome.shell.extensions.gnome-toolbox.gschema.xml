<schemalist gettext-domain="gnome-toolbox">
  <schema id="org.gnome.shell.extensions.gnome-toolbox" path="/org/gnome/shell/extensions/gnome-toolbox/">
    <!-- panel placement -->
    <key name="panel-box" type="s">
      <default>'right'</default>
      <summary>Panel section</summary>
      <description>Top bar section holding the toolbox indicator: left, center or right.</description>
    </key>
    <key name="panel-position" type="i">
      <default>0</default>
      <range min="0" max="99"/>
      <summary>Order inside the panel section</summary>
      <description>Lower values sit further left within the chosen section; values past the last item land on the far end.</description>
    </key>
    <!-- feature switches (hot toggle, no logout needed) -->
    <key name="enable-vitals" type="b">
      <default>true</default>
      <summary>Enable vitals monitor</summary>
      <description>Show CPU/memory/network load on the panel and details in the menu.</description>
    </key>
    <key name="enable-lock-keys" type="b">
      <default>true</default>
      <summary>Enable Num/Caps Lock indicator</summary>
      <description>Show lock key state on the panel with toggles in the menu.</description>
    </key>
    <key name="enable-clipboard" type="b">
      <default>true</default>
      <summary>Enable clipboard history</summary>
      <description>Keep a text clipboard history and expose it in the menu.</description>
    </key>
    <key name="enable-tray" type="b">
      <default>true</default>
      <summary>Enable AppIndicator/StatusNotifier tray</summary>
      <description>Claim org.kde.StatusNotifierWatcher and host indicator icons. The legacy XEmbed tray is controlled separately by legacy-tray-enabled.</description>
    </key>
    <!-- vitals panel -->
    <key name="update-interval" type="i">
      <default>2</default>
      <summary>Vitals update interval</summary>
      <description>How often (in seconds) vitals numbers refresh.</description>
    </key>
    <key name="show-cpu" type="b">
      <default>true</default>
      <summary>Show CPU load on panel</summary>
    </key>
    <key name="show-mem" type="b">
      <default>true</default>
      <summary>Show memory usage on panel</summary>
    </key>
    <key name="show-net" type="b">
      <default>true</default>
      <summary>Show network speed on panel</summary>
    </key>
    <key name="show-lock-keys" type="b">
      <default>true</default>
      <summary>Show Num/Caps Lock OSD toasts</summary>
    </key>
    <!-- clipboard -->
    <key name="history-size" type="i">
      <default>15</default>
      <summary>Clipboard history size</summary>
    </key>
    <key name="max-entry-length" type="i">
      <default>10000</default>
      <range min="500" max="100000"/>
      <summary>Max characters per history entry</summary>
      <description>Longer clipboard text is truncated to this many characters before being stored.</description>
    </key>
    <key name="show-clipboard-osd" type="b">
      <default>true</default>
      <summary>Show OSD toast on clipboard copy</summary>
      <description>Pop an on-screen toast whenever new content lands on the clipboard.</description>
    </key>
    <key name="paste-on-select" type="b">
      <default>false</default>
      <summary>Paste directly on select</summary>
      <description>Simulate Shift+Insert after selecting a history entry instead of only setting the clipboard.</description>
    </key>
    <!-- tray (compatible with appindicator settings) -->
    <key name="legacy-tray-enabled" type="b">
      <default>true</default>
      <summary>Enable legacy tray icons support</summary>
    </key>
    <key name="icon-saturation" type="d">
      <default>0.0</default>
      <summary>Saturation</summary>
    </key>
    <key name="icon-brightness" type="d">
      <default>0.0</default>
      <summary>Brightness</summary>
    </key>
    <key name="icon-contrast" type="d">
      <default>0.0</default>
      <summary>Contrast</summary>
    </key>
    <key name="icon-opacity" type="i">
      <default>240</default>
      <summary>Opacity</summary>
    </key>
    <key name="icon-size" type="i">
      <default>0</default>
      <summary>Icon size</summary>
      <description>Icon size in pixel, 0 follows the panel size.</description>
    </key>
    <key name="compact-mode-enabled" type="b">
      <default>true</default>
      <summary>Compact Mode</summary>
      <description>Reduces the spacing between indicators.</description>
    </key>
    <key name="tray-pos" type="s">
      <default>"right"</default>
      <summary>Position in tray</summary>
      <description>Set where the icon tray should appear.</description>
    </key>
    <key name="tray-order" type="i">
      <default>1</default>
      <summary>Order in tray</summary>
    </key>
    <key name="custom-icons" type="a(sss)">
      <default>[]</default>
      <summary>Custom icons</summary>
      <description>Replace any icons with custom icons from themes.</description>
    </key>
  </schema>
</schemalist>
